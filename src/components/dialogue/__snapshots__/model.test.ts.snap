      "isEntry": true,
      "isTerminal": false,
      "kind": "tree",
      "label": "start",
      "prompt": "The voices from above sing in frequencies beyond flesh... but their song speaks of unity, not this... this brutality.",
    },
    {
      "choices": [
        {
          "text": "What is the true message?",
          "toBeatId": "tree:end",
        },
        {
          "text": "How do you know this?",
          "toBeatId": "tree:end",
        },
      ],
      "id": "tree:voices",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "voices",
