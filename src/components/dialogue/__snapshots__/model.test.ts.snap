{
  "beats": [
    {
      "id": "greeting",
      "isEntry": true,
      "kind": "greeting",
      "label": "Opening greeting",
      "prompt": "The voices from above sing in frequencies beyond flesh... but their song speaks of unity, not this... this brutality.",
    },
    {
      "choices": [
        {
          "text": "What do the voices tell you?",
          "toBeatId": "tree:voices",
        },
        {
          "text": "The Chain says you speak heresy.",
