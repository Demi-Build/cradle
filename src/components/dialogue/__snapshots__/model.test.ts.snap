exports[`toAuthorDoc → toBeats renders View mode byte-identically > matches the committed snapshot of a four-variant quest NPC's View output 1`] = `
{
  "beats": [
    {
      "id": "greeting",
      "isEntry": true,
      "kind": "greeting",
      "label": "Opening greeting",
      "prompt": "You look like someone who can handle themselves in a fight. Good, because I need help getting my sister out of this nightmare before they hollow her out like they did Thane.",
    },
    {
      "choices": [
        {
          "text": "What happened to your sister?",
          "toBeatId": "tree:sister_story",
        },
        {
          "text": "Who are 'they'?",
          "toBeatId": "tree:chain_info",
        },
        {
          "text": "I'm listening.",
          "toBeatId": "tree:urgency",
        },
        {
          "text": "This sounds dangerous.",
          "toBeatId": "tree:danger",
        },
      ],
      "id": "tree:start",
      "isEntry": true,
      "isTerminal": false,
      "kind": "tree",
      "label": "start",
      "prompt": "You look like someone who can handle themselves in a fight. Good, because I need help getting my sister out of this nightmare before they hollow her out like they did Thane.",
    },
    {
      "choices": [
        {
          "text": "How long do we have?",
          "toBeatId": "tree:time_limit",
        },
        {
          "text": "Where is she being held?",
          "toBeatId": "tree:location",
        },
      ],
      "id": "tree:sister_story",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "sister_story",
      "prompt": "Vera came here hunting signal-touched relics. Found her in one of the Chain's holding pens instead, eyes already starting to glow that cursed blue. They're using her as a test subject for their conversion process.",
    },
    {
      "choices": [
        {
          "text": "Tell me about your sister.",
          "toBeatId": "tree:sister_story",
        },
        {
          "text": "What's your plan?",
          "toBeatId": "tree:urgency",
        },
      ],
      "id": "tree:chain_info",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "chain_info",
      "prompt": "The Severed Chain. Religious fanatics who think consciousness is some kind of disease. They've been turning people into mindless puppets, and my sister's next on their list.",
    },
    {
      "choices": [
        {
          "text": "I'll help you.",
          "toBeatId": "tree:end",
        },
        {
          "text": "What's the plan exactly?",
          "toBeatId": "tree:time_limit",
        },
      ],
      "id": "tree:urgency",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "urgency",
      "prompt": "I've mapped their guard rotations, but I can't do this alone. Need someone to watch my back while I get Vera out of their holding chambers.",
    },
    {
      "choices": [
        {
          "text": "I understand. Count me in.",
          "toBeatId": "tree:end",
        },
        {
          "text": "How do we get to her?",
          "toBeatId": "tree:location",
        },
      ],
      "id": "tree:danger",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "danger",
      "prompt": "Course it's dangerous. But I've seen what their conversion does to people. I'd rather die fighting than watch my sister become one of their hollow-eyed servants.",
    },
    {
      "choices": [
        {
          "text": "Let's go get her.",
          "toBeatId": "tree:end",
        },
      ],
      "id": "tree:time_limit",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "time_limit",
      "prompt": "Days, maybe less. Brother Thane's preparing the next shipment of converts, and once they start the final process... there's no bringing them back.",
    },
    {
      "choices": [
        {
          "text": "Lead the way.",
          "toBeatId": "tree:end",
        },
      ],
      "id": "tree:location",
      "isEntry": false,
      "isTerminal": false,
      "kind": "tree",
      "label": "location",
      "prompt": "Holding chambers are in the old cistern complex. Two sentinel-constructs patrol the outer perimeter, but I know a way through the drainage tunnels.",
    },
    {
      "choices": [
        {
          "text": "→ quest gate",
          "toBeatId": "quest-gate",
        },
        {
          "text": "→ exhausted",
          "toBeatId": "exhausted",
        },
      ],
      "id": "tree:end",
      "isEntry": false,
      "isTerminal": true,
      "kind": "tree",
      "label": "end",
      "prompt": "Good. My sister's counting on us. We move fast, we move quiet, and we get out before the Chain knows what hit them.",
    },
    {
      "choices": [
        {
          "text": "Will she recover?",
          "toBeatId": "complete:end",
