          "text": "→ exhausted",
          "toBeatId": "exhausted",
        },
      ],
      "id": "tree:end",
      "isEntry": false,
      "isTerminal": true,
      "kind": "tree",
      "label": "end",
      "prompt": "When the great transmission comes, you will understand... the metal fragments sing the same tune as distant stars...",
    },
    {
      "id": "exhausted",
      "isTerminal": true,
      "kind": "exhausted",
